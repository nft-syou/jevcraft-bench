{
  "name": "jevcraft-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "jevcraft": "node --env-file-if-exists=.env --import tsx packages/cli/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "figures": "node scripts/make-figures.mjs",
    "figures:refresh": "node scripts/make-figures.mjs --refresh",
    "plugin:test": "docker compose -f infra/docker-compose.yml run --rm gradle test",
    "plugin:build": "docker compose -f infra/docker-compose.yml run --rm gradle build"
  },
  "dependencies": {
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
